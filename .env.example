# Copy to .env (gitignored) and fill in real values.
# Never commit real secrets. Generate random secrets with:
#   openssl rand -base64 48

# =========================
# PostgreSQL
# =========================
POSTGRES_DB=devpulse_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Defaults point at compose.dev.yaml (localhost:5433). Override for AWS RDS.
# DB_HOST=localhost
# DB_PORT=5433


# =========================
# Redis
# =========================
REDIS_PORT=6379


# =========================
# JWT
# =========================
# Must be at least 32 bytes (256 bits) for HS256.
JWT_SECRET=change-me
# Optional overrides (defaults: 15m access token, 7d refresh token).
# JWT_ACCESS_TOKEN_TTL=15m
# JWT_REFRESH_TOKEN_TTL=7d
# Set to true once the app runs behind HTTPS.
# AUTH_COOKIE_SECURE=false


# =========================
# GitHub App (see docs/GITHUB_APP_SETUP.md)
# =========================
GITHUB_APP_ID=change-me
GITHUB_APP_SLUG=change-me
GITHUB_CLIENT_ID=change-me
GITHUB_CLIENT_SECRET=change-me
GITHUB_REDIRECT_URI=http://localhost:8080/api/github/oauth/callback
# Absolute path to the app's private key, kept outside the repo.
GITHUB_PRIVATE_KEY_PATH=/Users/you/.devpulse/github-app.pem


# =========================
# Encryption of stored secrets (GitHub tokens)
# =========================
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=change-me


# =========================
# Web (optional)
# =========================
# Origins allowed to call the API from a browser. Default: the Vite dev server.
# APP_ALLOWED_ORIGINS=http://localhost:5173


# =========================
# AWS S3 (optional)
# =========================
# AWS_REGION=eu-north-1
# AWS_S3_BUCKET=


# =========================
# Embedding model (optional)
# =========================
# Defaults download all-MiniLM-L6-v2 from a pinned Hugging Face revision
# into ~/.devpulse/model-cache on first start. Override for offline use:
# EMBEDDING_MODEL_URI=file:/absolute/path/model.onnx
# EMBEDDING_TOKENIZER_URI=file:/absolute/path/tokenizer.json
# EMBEDDING_CACHE_DIR=/absolute/path/model-cache


# =========================
# AI (optional)
# =========================
# Only needed when ai.provider=openai. Leave unset to use the mock provider.
# OPENAI_API_KEY=change-me
