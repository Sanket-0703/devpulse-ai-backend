### DevPulse API by hand — IntelliJ HTTP Client
# Pick the "local" environment (top of the editor), then click ▶ next to a request.
# Cookies are kept between requests, like a browser, so /refresh works after /login.
# Put your own test account below (never commit real passwords).

@email = you@example.com
@password = your-password

### Sign in — stores the access token for the requests below
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
  client.global.set("accessToken", response.body.accessToken);
  client.test("signed in", () => client.assert(response.status === 200));
%}

### Who am I?
GET {{host}}/api/auth/me
Authorization: Bearer {{accessToken}}

### New access token from the refresh cookie (rotates the cookie)
POST {{host}}/api/auth/refresh

> {% client.global.set("accessToken", response.body.accessToken); %}

### GitHub connection status
GET {{host}}/api/github/connection
Authorization: Bearer {{accessToken}}

### Start connecting GitHub — open the returned URL in a browser
POST {{host}}/api/github/connect
Authorization: Bearer {{accessToken}}

### "Sign in with GitHub" — look at the Location header of the 302
# @no-redirect
GET {{host}}/api/auth/github

### My repositories (search with q=, filter with reviewEnabled=true)
GET {{host}}/api/github/repositories?page=0&size=20
Authorization: Bearer {{accessToken}}

### Repository sync status
GET {{host}}/api/github/repositories/sync
Authorization: Bearer {{accessToken}}

### Sync repositories now (202; poll the status above)
POST {{host}}/api/github/repositories/sync
Authorization: Bearer {{accessToken}}

### Sync pull requests of {{repositoryId}} (only what changed since last time)
POST {{host}}/api/github/repositories/{{repositoryId}}/pull-requests/sync
Authorization: Bearer {{accessToken}}

### Pull requests (state=OPEN|MERGED|CLOSED, q=title, author or #number)
GET {{host}}/api/github/repositories/{{repositoryId}}/pull-requests?state=MERGED&page=0&size=20
Authorization: Bearer {{accessToken}}

### One pull request, with its description
GET {{host}}/api/github/repositories/{{repositoryId}}/pull-requests/{{prNumber}}
Authorization: Bearer {{accessToken}}

### Pull request files — run twice: the second answer comes from Redis
GET {{host}}/api/github/repositories/{{repositoryId}}/pull-requests/{{prNumber}}/files
Authorization: Bearer {{accessToken}}

### Try the demo — signs in to the seeded demo account (local only)
POST {{host}}/api/auth/demo

> {% client.global.set("accessToken", response.body.accessToken); %}

### Run an AI review of the demo pull request #12 (202, runs in the background)
POST {{host}}/api/github/repositories/{{demoRepositoryId}}/pull-requests/12/reviews
Authorization: Bearer {{accessToken}}

> {% client.global.set("reviewId", response.body.id); %}

### The review — re-run until status is SUCCEEDED
GET {{host}}/api/reviews/{{reviewId}}
Authorization: Bearer {{accessToken}}

### All your reviews
GET {{host}}/api/reviews?page=0&size=20
Authorization: Bearer {{accessToken}}

### AI usage today and this month, with your limits
GET {{host}}/api/reviews/usage
Authorization: Bearer {{accessToken}}

### Dashboard — onboarding steps, totals, open findings, recent reviews, usage
GET {{host}}/api/dashboard
Authorization: Bearer {{accessToken}}

### Playground review — run it 6 times within a minute to see the 429
POST {{host}}/api/playground/review
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "language": "JAVA",
  "code": "String q = \"SELECT * FROM users WHERE id = '\" + id + \"'\";\nSystem.out.println(q);"
}

### Review settings (automatic reviews, publishing)
GET {{host}}/api/settings/reviews
Authorization: Bearer {{accessToken}}

### Change review settings
PUT {{host}}/api/settings/reviews
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"autoReview": true, "autoPublish": false, "minPublishSeverity": "MEDIUM"}

### Latest webhook deliveries for your installation
GET {{host}}/api/github/webhooks/deliveries
Authorization: Bearer {{accessToken}}

### Publish a review to GitHub — posts on the real pull request!
POST {{host}}/api/reviews/{{reviewId}}/publish
Authorization: Bearer {{accessToken}}

### Webhook ping, signed like GitHub does (webhookSecret in http-client.private.env.json)
< {%
    const body = '{"zen":"Design for failure.","hook_id":1}';
    const signature = crypto.hmac.sha256()
        .withTextSecret(request.environment.get("webhookSecret"))
        .updateWithText(body)
        .digest().toHex();
    request.variables.set("signature", "sha256=" + signature);
%}
POST {{host}}/api/github/webhooks
Content-Type: application/json
X-GitHub-Event: ping
X-GitHub-Delivery: {{$uuid}}
X-Hub-Signature-256: {{signature}}

{"zen":"Design for failure.","hook_id":1}

### Index the demo repository's code (202; runs in the background)
POST {{host}}/api/github/repositories/{{demoRepositoryId}}/index
Authorization: Bearer {{accessToken}}

### The repository — re-run until indexStatus is SUCCEEDED
GET {{host}}/api/github/repositories/{{demoRepositoryId}}
Authorization: Bearer {{accessToken}}

### Search code by meaning (all your indexed repositories)
GET {{host}}/api/search?q=how is a session token checked&limit=5
Authorization: Bearer {{accessToken}}

### A bad token gives a JSON 401, never a 500
GET {{host}}/api/auth/me
Authorization: Bearer not-a-real-token

### Sign out
POST {{host}}/api/auth/logout
Authorization: Bearer {{accessToken}}
